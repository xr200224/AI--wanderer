# RapidAPI key for TripAdvisor/Ctrip-style travel data providers.
# Copy this file to .env or export these variables in your shell.

RAPIDAPI_KEY=your_rapidapi_key_here

# Default provider: Tripadvisor COM on RapidAPI.
RAPIDAPI_TRIPADVISOR_HOST=tripadvisor-com1.p.rapidapi.com
RAPIDAPI_TRIPADVISOR_BASE_PATH=

# Local proxy/static server port.
PORT=8787
